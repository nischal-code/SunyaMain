# Base URL of the Sunya backend API (Phase 2C-6)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Base URL for the Socket.IO connection. Optional — if unset, it's derived
# from VITE_API_BASE_URL by dropping the /api/v1 path (see src/hooks/useSocket.js
# and src/sockets/socketClient.js).
VITE_SOCKET_URL=http://localhost:8000
